# OpenAI Configuration
# Required: Your OpenAI API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# Optional: OpenAI embedding model (default: text-embedding-3-small)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: OpenAI chat model (default: gpt-3.5-turbo)
OPENAI_CHAT_MODEL=gpt-3.5-turbo

# Optional: Temperature for LLM responses (default: 0.7, range: 0.0-2.0)
OPENAI_TEMPERATURE=0.7

# Optional: Maximum tokens for LLM context (default: 4096)
OPENAI_MAX_TOKENS=4096

# Qdrant Configuration
# Required: Your Qdrant Cloud cluster URL (e.g., https://your-cluster.qdrant.io)
QDRANT_URL=https://your-cluster.qdrant.io

# Required: Your Qdrant Cloud API key
QDRANT_API_KEY=your-qdrant-api-key-here

# Optional: Collection name for storing embeddings (default: book_chunks)
QDRANT_COLLECTION_NAME=book_chunks

# RAG Configuration
# Optional: Maximum tokens per chunk (default: 512)
CHUNK_SIZE=512

# Optional: Token overlap between chunks (default: 50)
CHUNK_OVERLAP=50

# Optional: Number of top results to retrieve (default: 5)
TOP_K_RESULTS=5

# Retry Configuration
# Optional: Maximum retry attempts for API calls (default: 3)
MAX_RETRIES=3

# Optional: Exponential backoff factor (default: 2.0)
RETRY_BACKOFF_FACTOR=2.0

# Logging Configuration
# Optional: Log level (default: INFO, options: DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
